# Real TCGA-BRCA downloads and derived expression matrices (69MB,
# public, reproducible from data/TCGA-BRCA/README.md + 01_build_cohorts.py)
data/TCGA-BRCA/*.gz
data/TCGA-BRCA/BRCA_clinicalMatrix
data/TCGA-BRCA/tnbc_expr.csv
data/TCGA-BRCA/luma_expr.csv

# Real GSE176078 single-cell TNBC download (CID44971, ~178MB raw .mtx,
# public, reproducible via GEO accession GSM5354531, see data/GSE176078_singlecell/README.md)
data/GSE176078_singlecell/*.mtx
data/GSE176078_singlecell/*.tsv
data/GSE176078_singlecell/*.csv

# Real GSE167150 Hi-C downloads (4 real samples -- 3 TNBC tumors +
# 1 matched normal, ~3.5GB total .hic, public, reproducible via
# scripts/download_hic_tnbc_tissue3.py, see data/GSE167150_HiC/README.md)
data/GSE167150_HiC/*.hic

# Real hg19 reference sequence + RefSeq gene table (UCSC, ~32MB,
# public, reproducible from the URLs in scripts/32_hic_compartment_validation.py)
data/hg19_annotation/*.gz
